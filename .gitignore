# Secrets: contact details for the build. Copy .env.example to .env.
.env
.env.*
!.env.example

# Generated by `node tools/build.mjs` (the GitHub Actions workflow builds them on every push).
# contact.html carries the contact details from .env, so it is never committed.
/contact.html
/work/
/_site/

# Private working notes (design history, comparisons)
/notes/

# Tooling and OS clutter
node_modules/
.taste-skill/
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
